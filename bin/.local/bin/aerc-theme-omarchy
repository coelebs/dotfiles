#!/usr/bin/env bash

set -eu

palette="$HOME/.local/state/omarchy/current/theme/colors.toml"
stylesets="$HOME/.config/aerc/stylesets"
styleset="$stylesets/omarchy"

color() {
  local name="$1"
  local value

  value=$(awk -F ' = ' -v name="$name" '$1 == name { gsub(/"/, "", $2); print $2; exit }' "$palette")
  if [[ ! $value =~ ^#[[:xdigit:]]{6}$ ]]; then
    printf 'Missing or invalid Omarchy color: %s\n' "$name" >&2
    exit 1
  fi
  printf '%s' "$value"
}

[[ -r $palette ]] || {
  printf 'Omarchy palette not found: %s\n' "$palette" >&2
  exit 1
}

background=$(color background)
dark_background=$(color dark_background)
lighter_background=$(color lighter_background)
foreground=$(color foreground)
dark_foreground=$(color dark_foreground)
bright_foreground=$(color bright_foreground)
accent=$(color accent)
selection=$(color selection)
muted=$(color muted)
red=$(color red)
yellow=$(color yellow)
green=$(color green)
cyan=$(color cyan)
blue=$(color blue)
magenta=$(color magenta)

mkdir -p "$stylesets"
temporary=$(mktemp "$styleset.XXXXXX")
trap 'rm -f "$temporary"' EXIT

printf '%s\n' \
  '# Generated from the active Omarchy palette. Do not edit.' \
  '*.default=true' \
  '*.normal=true' \
  "default.fg=$foreground" \
  "default.bg=$background" \
  "error.fg=$red" \
  'error.bold=true' \
  "warning.fg=$yellow" \
  'warning.bold=true' \
  "success.fg=$green" \
  'success.bold=true' \
  "title.fg=$bright_foreground" \
  "title.bg=$accent" \
  'title.bold=true' \
  "header.fg=$blue" \
  'header.bold=true' \
  "border.bg=$muted" \
  "tab.fg=$foreground" \
  "tab.bg=$dark_background" \
  "stack.fg=$foreground" \
  "stack.bg=$dark_background" \
  "statusline_default.fg=$foreground" \
  "statusline_default.bg=$dark_background" \
  "statusline_error.fg=$red" \
  "statusline_success.fg=$green" \
  "msglist_default.fg=$foreground" \
  "msglist_default.bg=$background" \
  "msglist_unread.fg=$bright_foreground" \
  'msglist_unread.bold=true' \
  "msglist_read.fg=$dark_foreground" \
  "msglist_flagged.fg=$yellow" \
  "msglist_deleted.fg=$red" \
  'msglist_deleted.dim=true' \
  "msglist_marked.fg=$bright_foreground" \
  "msglist_marked.bg=$magenta" \
  "msglist_result.fg=$cyan" \
  "msglist_gutter.bg=$background" \
  "msglist_pill.fg=$bright_foreground" \
  "msglist_pill.bg=$accent" \
  "dirlist_default.fg=$foreground" \
  "dirlist_default.bg=$dark_background" \
  "dirlist_unread.fg=$bright_foreground" \
  'dirlist_unread.bold=true' \
  "dirlist_recent.fg=$accent" \
  "part_switcher.bg=$dark_background" \
  "part_filename.fg=$foreground" \
  "part_mimetype.fg=$muted" \
  "completion_default.fg=$foreground" \
  "completion_default.bg=$lighter_background" \
  "completion_description.fg=$dark_foreground" \
  "completion_gutter.bg=$lighter_background" \
  "completion_pill.fg=$bright_foreground" \
  "completion_pill.bg=$accent" \
  "selector_default.fg=$foreground" \
  "selector_default.bg=$background" \
  "selector_focused.fg=$bright_foreground" \
  "selector_focused.bg=$selection" \
  'selector_focused.bold=true' \
  "selector_chooser.fg=$accent" \
  'selector_chooser.bold=true' \
  "spinner.fg=$accent" \
  "*.selected.fg=$bright_foreground" \
  "*.selected.bg=$selection" \
  '*.selected.bold=true' \
  '' \
  '[viewer]' \
  "url.fg=$cyan" \
  'url.underline=true' \
  "header.fg=$blue" \
  'header.bold=true' \
  "signature.fg=$dark_foreground" \
  'signature.dim=true' \
  "diff_meta.fg=$magenta" \
  'diff_meta.bold=true' \
  "diff_chunk.fg=$cyan" \
  "diff_chunk_func.fg=$cyan" \
  "diff_add.fg=$green" \
  "diff_del.fg=$red" \
  "quote_1.fg=$cyan" \
  "quote_2.fg=$blue" \
  "quote_3.fg=$green" \
  "quote_4.fg=$magenta" \
  "quote_x.fg=$muted" \
  >"$temporary"

mv "$temporary" "$styleset"
trap - EXIT

# Reload only through a live IPC socket. A stale aerc.sock would otherwise make
# this command launch a new client instance.
runtime_dir=${XDG_RUNTIME_DIR:-"/run/user/$(id -u)"}
socket="$runtime_dir/aerc.sock"
if ss -xl | grep -Fq "$socket"; then
  aerc ':reload -s omarchy' >/dev/null 2>&1 || true
fi
