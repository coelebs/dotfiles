diff --git a/bin/omarchy-launch-browser b/bin/omarchy-launch-browser
index 044b220d..c8b74a79 100755
--- a/bin/omarchy-launch-browser
+++ b/bin/omarchy-launch-browser
@@ -7,7 +7,18 @@ default_browser=$(env -u BROWSER xdg-settings get default-web-browser)
 if [[ -z $default_browser ]]; then
   default_browser=$(xdg-mime query default x-scheme-handler/https)
 fi
-browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$default_browser 2>/dev/null | head -1)
+application_dirs=("$HOME/.local/share" "$HOME/.nix-profile/share")
+if [[ -n ${XDG_DATA_DIRS:-} ]]; then
+  IFS=: read -r -a xdg_application_dirs <<<"$XDG_DATA_DIRS"
+  application_dirs+=("${xdg_application_dirs[@]}")
+fi
+application_dirs+=("/run/current-system/sw/share" "/usr/share")
+
+desktop_entries=()
+for application_dir in "${application_dirs[@]}"; do
+  desktop_entries+=("$application_dir/applications/$default_browser")
+done
+browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "${desktop_entries[@]}" 2>/dev/null | head -1)
 
 if $browser_exec --help 2>/dev/null | grep -q MOZ_LOG; then
   private_flag="--private-window"
