alias ls='ls --color -lh --group-directories-first'
alias vim='nvim'
alias log='nvim + ~/local/notes/log.md'

alias cdh='cd $(git rev-parse --show-toplevel)'
cdhh() {
  local directory
  directory=$(git rev-parse --show-superproject-working-tree 2>/dev/null)
  if [ -z "$directory" ]; then
    directory=$(git rev-parse --show-toplevel) || return
  fi
  cd "$directory"
}

if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never -p'
fi

function geturl() {
  FULLPATH="$1"
  IP=$(hostname -I | cut -d " " -f 1)

  case $FULLPATH in
    "/srv/ftp/"*)
        RELPATH=${FULLPATH/\/srv\/ftp}
        echo "ftp://$IP$RELPATH"
        echo "http://$IP$RELPATH"
        echo "ftp://$IP$RELPATH" | xclip
        ;;
    *)
        cp $FULLPATH /srv/ftp/auto/
        geturl /srv/ftp/auto/$(basename $FULLPATH)
        ;;
  esac
}

function dtb2dts() {
  local dtb=$1
  local dts=$2

  dtc -I dtb -O dts -o "${dts}" "${dtb}"
}

alias lscp="scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
alias lssh="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
